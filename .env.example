# Copy to .env and fill in. The system also runs without a key via --no-llm.
ANTHROPIC_API_KEY=sk-ant-...

# live | replay | record  — replay reads recorded fixtures, needs no key (CI default)
APCOPILOT_LLM_MODE=live

# Pinned so past-due checks and the eval are reproducible. The sample corpus is
# dated Jan 2026 with Feb-Mar 2026 due dates.
APCOPILOT_AS_OF_DATE=2026-02-01
