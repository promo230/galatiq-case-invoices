# Copy to .env, then uncomment ONE block below. Everything here is optional:
# with no key the system runs fully offline on the deterministic parsers and
# rules (APCOPILOT_LLM_MODE=off pins that explicitly; the default `live` with
# no key degrades to the same paths). Modes: live | replay | record | off.
# Full details: SETUP.md §3.

## Demonstrated engine — xAI Grok (what the recorded run and the README
## screenshots used).
#APCOPILOT_LLM_PROVIDER=openai_compat
#APCOPILOT_OPENAI_BASE_URL=https://api.x.ai/v1
#APCOPILOT_OPENAI_API_KEY=xai-...
#APCOPILOT_EXTRACT_MODEL=grok-4.20-non-reasoning
#APCOPILOT_EXTRACT_RETRY_MODEL=grok-4.20
#APCOPILOT_APPROVAL_MODEL=grok-4.20
#APCOPILOT_CRITIC_MODEL=grok-4.20

## Zero-cost live run — Gemini free tier (key from https://aistudio.google.com/apikey).
## Local Ollama works the same way: base URL http://localhost:11434/v1, no key.
#APCOPILOT_LLM_PROVIDER=openai_compat
#APCOPILOT_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#APCOPILOT_OPENAI_API_KEY=your-key-here
#APCOPILOT_EXTRACT_MODEL=gemini-2.5-flash-lite
#APCOPILOT_EXTRACT_RETRY_MODEL=gemini-2.5-flash
#APCOPILOT_APPROVAL_MODEL=gemini-2.5-flash
#APCOPILOT_CRITIC_MODEL=gemini-2.5-flash

## Anthropic (code default) — no provider config needed, just the key.
#ANTHROPIC_API_KEY=sk-ant-...

## Keyless replay of the committed Grok fixtures — no key, no network.
## See "Replaying the committed Grok traces" in SETUP.md §3.
#APCOPILOT_LLM_MODE=replay
#APCOPILOT_EXTRACT_MODEL=grok-4.20-non-reasoning
#APCOPILOT_EXTRACT_RETRY_MODEL=grok-4.20
#APCOPILOT_APPROVAL_MODEL=grok-4.20
#APCOPILOT_CRITIC_MODEL=grok-4.20

# Pinned so past-due checks and the eval are reproducible. The sample corpus is
# dated Jan 2026 with Feb-Mar 2026 due dates.
APCOPILOT_AS_OF_DATE=2026-02-01
